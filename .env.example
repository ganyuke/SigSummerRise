# Dedicated bot Signal account (E.164) used by signal-cli -a
SIGNAL_ACCOUNT=+15555550100

# From: signal-cli -a "$SIGNAL_ACCOUNT" listGroups -d (required)
SIGNAL_GROUP_ID=

# Bot ACI used to detect Signal mentions. Set this, or listAccounts must return it.
SIGNAL_BOT_ACI=

# signal-cli HTTP daemon (loopback only)
SIGNAL_HTTP_URL=http://127.0.0.1:8080

# Public origin used in magic links (https in production)
PUBLIC_BASE_URL=https://sigsummerrise.example.com

OPENROUTER_API_KEY=
# Must have a ZDR endpoint; requests always set provider.zdr and data_collection=deny
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731

MAX_N=200
ASK_CONTEXT_N=50

DB_PATH=/var/lib/sigsummerrise/sigsummerrise.db
# Passphrase for SQLCipher. Use a long random string. Never commit the real value.
DB_KEY=

BIND_HOST=127.0.0.1
BIND_PORT=8000

MAGIC_TOKEN_TTL_SECONDS=900
SESSION_TTL_SECONDS=86400
DASHBOARD_LINKS_PER_HOUR=3
LLM_CALLS_PER_HOUR=10

# Bot reply copy (JSON). Defaults to copy/responses.json; falls back to copy/responses.example.json.
# Copy the example and customize locally; keep your private copy out of git.
RESPONSES_PATH=copy/responses.json
